<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold tracking-tight">Gastos e ingresos</h1>
    <%= link_to new_transaction_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-gray-900 text-white text-sm font-medium px-3.5 py-2 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors" do %>
      <%= icon(:plus, class: "h-4 w-4") %> Nuevo
    <% end %>
  </div>

  <% if @transactions.any? %>
    <div class="divide-y divide-gray-100 dark:divide-gray-800">
      <% @transactions.each do |t| %>
        <div class="group flex items-center gap-3 py-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full <%= t.ingreso? ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400' : 'bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400' %>">
            <%= icon(t.ingreso? ? :arrow_down : :arrow_up, class: "h-4 w-4") %>
          </div>

          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium truncate"><%= t.description %></p>
            <p class="text-xs text-gray-400 mt-0.5">
              <%= t.category&.name || "Sin categoría" %><%= " · #{t.client.name}" if t.client %> · <%= l(t.date, format: :short) %>
            </p>
          </div>

          <span class="text-sm font-semibold tabular-nums <%= t.ingreso? ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-900 dark:text-gray-100' %>">
            <%= t.ingreso? ? "+" : "−" %>$<%= number_with_precision(t.amount, precision: 2) %>
          </span>

          <div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            <%= link_to edit_transaction_path(t), class: "p-1.5 rounded-md text-gray-400 hover:text-gray-900 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-800", "aria-label": "Editar" do %>
              <%= icon(:pencil, class: "h-4 w-4") %>
            <% end %>
            <%= link_to transaction_path(t), data: { turbo_method: :delete, turbo_confirm: "¿Eliminar esta transacción?" }, class: "p-1.5 rounded-md text-gray-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30", "aria-label": "Eliminar" do %>
              <%= icon(:trash, class: "h-4 w-4") %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-200 dark:border-gray-800 py-12 text-center">
      <p class="text-sm text-gray-400">No hay transacciones registradas</p>
      <%= link_to "Registrar la primera", new_transaction_path, class: "mt-2 inline-block text-sm font-medium text-gray-900 dark:text-white hover:underline" %>
    </div>
  <% end %>
</div>
