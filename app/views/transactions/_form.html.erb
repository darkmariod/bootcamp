<%
  field = "w-full px-3 py-2.5 border border-gray-200 dark:border-gray-800 rounded-lg bg-white dark:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 dark:focus:ring-white transition-shadow"
  label = "block text-sm font-medium mb-1.5"
%>
<%= form_with model: transaction, local: true do |f| %>
  <% if transaction.errors.any? %>
    <div class="mb-4 rounded-lg bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-sm px-4 py-3">
      <%= transaction.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :description, "Descripción", class: label %>
      <%= f.text_field :description, class: field, placeholder: "Ej: Almuerzo" %>
    </div>

    <div>
      <%= f.label :amount, "Monto", class: label %>
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
        <%= f.number_field :amount, step: 0.01, class: "#{field} pl-7 tabular-nums" %>
      </div>
    </div>

    <div>
      <%= f.label :date, "Fecha", class: label %>
      <%= f.date_field :date, value: (f.object.date || Date.current), class: field %>
    </div>

    <div>
      <%= f.label :kind, "Tipo", class: label %>
      <%= f.select :kind, [["Ingreso", "ingreso"], ["Gasto personal", "gasto_personal"], ["Gasto de cliente", "gasto_cliente"]], {}, class: field %>
    </div>

    <div>
      <%= f.label :category_id, "Categoría", class: label %>
      <%= f.collection_select :category_id, categories, :id, :name, { prompt: "Seleccioná una" }, class: field %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit submit_label, class: "flex-1 rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors cursor-pointer" %>
      <%= link_to "Cancelar", transactions_path, class: "flex-1 rounded-lg border border-gray-200 dark:border-gray-800 text-sm py-2.5 text-center hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" %>
    </div>
  </div>
<% end %>
