<%
  field = "w-full px-3 py-2.5 border border-gray-200 dark:border-gray-800 rounded-lg bg-white dark:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 dark:focus:ring-white transition-shadow"
%>
<div class="max-w-sm mx-auto pt-8 space-y-8">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Iniciá sesión</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Bienvenido de nuevo.</p>
  </div>

  <%= form_with local: true, scope: :user, url: user_session_path do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: field, placeholder: "tu@email.com" %>
      </div>
      <div>
        <%= f.label :password, "Contraseña", class: "block text-sm font-medium mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password", class: field, placeholder: "••••••••" %>
      </div>
      <label class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
        <%= f.check_box :remember_me, class: "rounded border-gray-300 dark:border-gray-700" %>
        Mantener sesión iniciada
      </label>
      <%= f.submit "Ingresar", class: "w-full rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors cursor-pointer" %>
    </div>
  <% end %>

  <p class="text-center text-sm text-gray-500 dark:text-gray-400">
    ¿No tenés cuenta?
    <%= link_to "Creá una", new_user_registration_path, class: "font-medium text-gray-900 dark:text-white hover:underline" %>
  </p>
</div>
