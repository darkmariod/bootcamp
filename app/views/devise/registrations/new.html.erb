<%
  field = "w-full px-3 py-2.5 border border-gray-200 dark:border-gray-800 rounded-lg bg-white dark:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 dark:focus:ring-white transition-shadow"
%>
<div class="max-w-sm mx-auto pt-8 space-y-8">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Creá tu cuenta</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Empezá a controlar tus finanzas.</p>
  </div>

  <%= form_with local: true, url: user_registration_path do |f| %>
    <% if resource.errors.any? %>
      <div class="mb-4 rounded-lg bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-sm px-4 py-3">
        <%= resource.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: field, placeholder: "tu@email.com" %>
      </div>
      <div>
        <%= f.label :password, "Contraseña", class: "block text-sm font-medium mb-1.5" %>
        <%= f.password_field :password, autocomplete: "new-password", class: field, placeholder: "Mínimo 6 caracteres" %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Repetí la contraseña", class: "block text-sm font-medium mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: field, placeholder: "••••••••" %>
      </div>
      <%= f.submit "Crear cuenta", class: "w-full rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors cursor-pointer" %>
    </div>
  <% end %>

  <p class="text-center text-sm text-gray-500 dark:text-gray-400">
    ¿Ya tenés cuenta?
    <%= link_to "Iniciá sesión", new_user_session_path, class: "font-medium text-gray-900 dark:text-white hover:underline" %>
  </p>
</div>
