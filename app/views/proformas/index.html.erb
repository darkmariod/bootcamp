<% content_for :title, "Proformas — LawyerEC" %>

<%= page_header "Proformas", "Presupuestos de honorarios del consorcio" do %>
  <%= link_to "Nueva proforma", new_proforma_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <div class="p-4 border-b border-stone-100">
    <%= form_with url: proformas_path, method: :get, class: "flex flex-wrap gap-2" do |form| %>
      <%= form.text_field :q, value: params[:q], placeholder: "Buscar por número o cliente...",
            class: "flex-1 min-w-48 rounded-lg border border-stone-300 px-3 py-2 text-sm focus:outline-brass-400" %>
      <%= form.select :status,
            options_for_select(Proforma::STATUS_LABELS.map { |k, v| [ v, k ] }, params[:status]),
            { include_blank: "Todos los estados" },
            class: "rounded-lg border border-stone-300 px-3 py-2 text-sm" %>
      <%= form.submit "Filtrar", class: "btn btn-ghost" %>
    <% end %>
  </div>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-stone-500 border-b border-stone-100">
        <th class="px-5 py-3">Número</th>
        <th class="px-5 py-3">Cliente</th>
        <th class="px-5 py-3">Emisión</th>
        <th class="px-5 py-3">Estado</th>
        <th class="px-5 py-3">Total</th>
        <th class="px-5 py-3">Abogado</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% @proformas.each do |proforma| %>
        <tr class="hover:bg-stone-50">
          <td class="px-5 py-3">
            <%= link_to proforma.number, proforma_path(proforma), class: "font-medium text-ink-900 hover:underline" %>
            <% if proforma.legal_case %>
              <p class="text-xs text-stone-400"><%= proforma.legal_case.title %></p>
            <% end %>
          </td>
          <td class="px-5 py-3 text-stone-600"><%= proforma.client.name %></td>
          <td class="px-5 py-3 text-stone-500 text-xs"><%= l proforma.issued_on %></td>
          <td class="px-5 py-3"><%= proforma_status_badge(proforma) %></td>
          <td class="px-5 py-3 font-semibold text-ink-900"><%= usd proforma.total_amount %></td>
          <td class="px-5 py-3 text-stone-600"><%= proforma.user&.display_name %></td>
        </tr>
      <% end %>
      <% if @proformas.empty? %>
        <tr><td colspan="6" class="px-5 py-10 text-center text-stone-400">Aún no hay proformas registradas.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
