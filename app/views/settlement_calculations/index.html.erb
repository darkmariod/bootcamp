<% content_for :title, "Historial de liquidaciones — LawyerEC" %>

<%= page_header "Liquidaciones laborales", "Historial de cálculos del consorcio" do %>
  <%= link_to "Nuevo cálculo", new_settlement_calculation_path, class: "px-4 py-2 rounded-lg bg-ink-900 text-white text-sm font-medium hover:bg-ink-900" %>
<% end %>

<div class="card">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-stone-500 border-b border-stone-100">
        <th class="px-5 py-3">Trabajador</th>
        <th class="px-5 py-3">Sueldo</th>
        <th class="px-5 py-3">Servicio</th>
        <th class="px-5 py-3">Causa</th>
        <th class="px-5 py-3">Total</th>
        <th class="px-5 py-3">Fecha</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% @calculations.each do |calc| %>
        <tr class="hover:bg-stone-50">
          <td class="px-5 py-3">
            <%= link_to calc.worker_name, settlement_calculation_path(calc), class: "font-medium text-ink-900 hover:underline" %>
            <% if calc.legal_case %>
              <p class="text-xs text-stone-400"><%= calc.legal_case.title %></p>
            <% end %>
          </td>
          <td class="px-5 py-3 text-stone-600"><%= usd calc.monthly_salary %></td>
          <td class="px-5 py-3 text-stone-600"><%= calc.details&.dig("service_text") %></td>
          <td class="px-5 py-3 text-stone-600"><%= calc.reason_label %></td>
          <td class="px-5 py-3 font-semibold text-ink-900"><%= usd calc.total_amount %></td>
          <td class="px-5 py-3 text-stone-500 text-xs"><%= l calc.created_at, format: :short %></td>
        </tr>
      <% end %>
      <% if @calculations.empty? %>
        <tr><td colspan="6" class="px-5 py-10 text-center text-stone-400">Aún no hay cálculos registrados.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
