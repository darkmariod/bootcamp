<% content_for :title, "Calcular pensión alimenticia — LawyerEC" %>

<%= page_header "Calculadora de Pensión Alimenticia",
      "Tabla oficial 2026 — Acuerdo Ministerial MDH-DM-2026-0005-A · SBU $482" do %>
  <%= link_to "Historial", alimony_calculations_path, class: "btn btn-ghost" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
  <div class="card p-6">
    <%= render "form", calculation: @calculation %>
  </div>

  <div id="result">
    <div class="rounded-xl border-2 border-dashed border-stone-300 p-10 text-center text-stone-400">
      <div class="flex justify-center mb-3 text-ink-300"><%= icon :scale, css: "w-12 h-12" %></div>
      <p class="text-sm">Complete los datos y presione <strong>Calcular</strong>.<br>
      El resultado aparecerá aquí con el desglose legal completo.</p>
    </div>
  </div>
</div>
