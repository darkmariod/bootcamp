<%= turbo_stream.update "result" do %>
  <div class="rounded-xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
    <p class="font-semibold mb-2">Revise los datos ingresados:</p>
    <ul class="list-disc pl-5 space-y-1">
      <% @calculation.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
