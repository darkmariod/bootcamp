<%= form_with model: calculation, class: "space-y-5" do |form| %>
  <div>
    <label class="field-label">Nombre del alimentante (demandado) *</label>
    <%= form.text_field :applicant_name, placeholder: "Ej: Juan Pérez",
          class: "field" %>
  </div>

  <div>
    <label class="field-label">Ingreso mensual (USD) *</label>
    <%= form.number_field :monthly_income, step: 0.01, min: 0, placeholder: "Ej: 950.00",
          class: "field" %>
    <label class="flex items-center gap-2 mt-2 text-sm text-stone-600">
      <%= form.check_box :iess_deducted, class: "rounded border-stone-300" %>
      El valor ya tiene descontado el aporte al IESS (9.45%)
    </label>
    <p class="text-xs text-stone-400 mt-1">La pensión se calcula sobre el ingreso neto (Sentencia 048-13-SCN-CC).</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="field-label">Hijos de 0 a 2 años</label>
      <%= form.number_field :children_under_3, min: 0,
            class: "field" %>
    </div>
    <div>
      <label class="field-label">Hijos de 3 años o más</label>
      <%= form.number_field :children_3_plus, min: 0,
            class: "field" %>
    </div>
  </div>

  <div>
    <label class="field-label">Hijos que demandan la pensión</label>
    <%= form.number_field :claimed_children, min: 1, placeholder: "Vacío = todos",
          class: "field" %>
    <p class="text-xs text-stone-400 mt-1">El nivel se ubica con el total de hijos; se paga la porción de quienes demandan (Art. 13).</p>
  </div>

  <div>
    <label class="field-label">Discapacidad de algún hijo</label>
    <%= form.select :disability_range,
          options_for_select(AlimonyCalculation::DISABILITY_LABELS.map { |k, v| [ v, k ] }, calculation.disability_range),
          {}, class: "field" %>
    <p class="text-xs text-stone-400 mt-1">Suplemento por hogar según el mayor grado de discapacidad (Art. 10).</p>
  </div>

  <% if calculation.legal_case_id.present? || params[:legal_case_id].present? %>
    <%= form.hidden_field :legal_case_id, value: calculation.legal_case_id || params[:legal_case_id] %>
    <p class="text-xs text-amber-600">Este cálculo quedará vinculado al caso seleccionado.</p>
  <% end %>

  <%= form.submit "Calcular pensión", class: "btn btn-gold w-full" %>
<% end %>
