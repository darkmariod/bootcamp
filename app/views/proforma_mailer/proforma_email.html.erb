<div style="font-family: Arial, Helvetica, sans-serif; max-width: 560px; margin: 0 auto; color: #1e293b;">
  <div style="background: #0f172a; color: #ffffff; padding: 24px; border-radius: 12px 12px 0 0;">
    <h1 style="margin: 0; font-size: 20px;">Lawyer<span style="color:#f59e0b;">EC</span></h1>
    <p style="margin: 4px 0 0; font-size: 13px; color: #94a3b8;">Proforma de honorarios <%= @proforma.number %></p>
  </div>

  <div style="border: 1px solid #e2e8f0; border-top: none; padding: 24px; border-radius: 0 0 12px 12px;">
    <p style="font-size: 14px;">
      Cliente: <strong><%= @proforma.client.name %></strong><br>
      Emisión: <%= @proforma.issued_on.strftime("%d/%m/%Y") %>
      <% if @proforma.valid_until %> · Válida hasta: <%= @proforma.valid_until.strftime("%d/%m/%Y") %><% end %>
    </p>

    <table style="width: 100%; font-size: 13px; border-collapse: collapse; margin-top: 12px;">
      <tr style="text-align: left; color: #64748b; font-size: 11px; text-transform: uppercase;">
        <th style="padding: 6px 0; border-bottom: 1px solid #e2e8f0;">Descripción</th>
        <th style="padding: 6px 0; border-bottom: 1px solid #e2e8f0; text-align: center;">Cant.</th>
        <th style="padding: 6px 0; border-bottom: 1px solid #e2e8f0; text-align: right;">Subtotal</th>
      </tr>
      <% @proforma.proforma_items.each do |item| %>
        <tr>
          <td style="padding: 6px 0; border-bottom: 1px solid #f1f5f9;"><%= item.description %></td>
          <td style="padding: 6px 0; border-bottom: 1px solid #f1f5f9; text-align: center;"><%= item.quantity.to_i %></td>
          <td style="padding: 6px 0; border-bottom: 1px solid #f1f5f9; text-align: right;">$<%= sprintf('%.2f', item.subtotal) %></td>
        </tr>
      <% end %>
      <tr>
        <td colspan="2" style="padding: 10px 0; text-align: right; font-weight: bold;">Total</td>
        <td style="padding: 10px 0; text-align: right; font-weight: bold; font-size: 16px;">$<%= sprintf('%.2f', @proforma.total_amount) %></td>
      </tr>
    </table>

    <% if @proforma.notes.present? %>
      <p style="font-size: 12px; color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-top: 16px; white-space: pre-line;"><%= @proforma.notes %></p>
    <% end %>

    <p style="font-size: 11px; color: #94a3b8; margin-top: 20px;">
      Documento informativo de honorarios profesionales. No constituye factura ni comprobante tributario.
    </p>
  </div>
</div>
