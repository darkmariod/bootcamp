<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "LawyerEC — Gestión Legal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# PWA — installable app %>
    <meta name="theme-color" content="#111d30">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="LawyerEC">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;450;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="flex min-h-screen">
        <aside class="w-64 shrink-0 fixed inset-y-0 flex flex-col text-ink-100"
               style="background: linear-gradient(180deg, var(--color-ink-950), var(--color-ink-900));">
          <div class="px-6 py-6 border-b border-white/5">
            <div class="flex items-center gap-2.5">
              <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-brass-500/15 text-brass-300 ring-1 ring-brass-400/25">
                <%= icon :scale, css: "w-5 h-5" %>
              </span>
              <div>
                <h1 class="display text-xl leading-none text-white font-semibold">Lawyer<span class="text-brass-400">EC</span></h1>
                <p class="text-[11px] text-ink-300 mt-1 tracking-wide">CONSORCIO JURÍDICO</p>
              </div>
            </div>
          </div>

          <nav class="flex-1 px-3 py-5 space-y-1 overflow-y-auto">
            <%= nav_link "Panel", root_path, :dashboard, active: current_page?(root_path) %>

            <p class="px-3 pt-5 pb-2 text-[10px] uppercase tracking-[0.14em] text-ink-400 font-semibold">Catálogo</p>
            <%= nav_link "Clientes", clients_path, :users, active: request.path.start_with?("/clients") %>
            <%= nav_link "Casos", legal_cases_path, :folder, active: request.path.start_with?("/legal_cases") %>
            <%= nav_link "Proformas", proformas_path, :document, active: request.path.start_with?("/proformas") %>

            <p class="px-3 pt-5 pb-2 text-[10px] uppercase tracking-[0.14em] text-ink-400 font-semibold">Calculadoras</p>
            <%= nav_link "Finiquito", new_settlement_calculation_path, :briefcase, active: request.path.start_with?("/settlement"), badge: "Principal" %>
            <%= nav_link "Pensión Alimenticia", alimony_calculations_path, :scale, active: request.path.start_with?("/alimony") %>

            <% if Current.user&.admin? %>
              <p class="px-3 pt-5 pb-2 text-[10px] uppercase tracking-[0.14em] text-ink-400 font-semibold">Administración</p>
              <%= nav_link "Usuarios y roles", users_path, :shield, active: request.path.start_with?("/users") %>
            <% end %>
          </nav>

          <div class="px-4 py-4 border-t border-white/5">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-9 h-9 rounded-full bg-brass-500 text-white text-sm font-semibold shrink-0">
                <%= Current.user&.display_name.to_s.first&.upcase %>
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-white truncate"><%= Current.user&.display_name %></p>
                <p class="text-[11px] text-ink-300 truncate"><%= Current.user&.role_label %></p>
              </div>
              <%= button_to session_path, method: :delete, class: "text-ink-300 hover:text-white cursor-pointer shrink-0",
                    form: { title: "Cerrar sesión" } do %>
                <%= icon :logout, css: "w-5 h-5" %>
              <% end %>
            </div>
          </div>
        </aside>

        <main class="flex-1 ml-64 px-8 py-8 max-w-[1400px]">
          <% if notice.present? %>
            <div class="mb-5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm flex items-center gap-2">
              <%= icon :shield, css: "w-4 h-4" %> <%= notice %>
            </div>
          <% end %>
          <% if alert.present? %>
            <div class="mb-5 rounded-xl bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm"><%= alert %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
