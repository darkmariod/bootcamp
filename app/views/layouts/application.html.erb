<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Control de Finanzas</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="Gestiona tus gastos e ingresos fácilmente">

    <!-- PWA: Manifest and meta tags for installability -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Finanzas">

    <!-- iPhone home screen icon -->
    <link rel="apple-touch-icon" href="/icon-192.svg">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Dark mode preference script (runs before paint) -->
    <script>
      (function () {
        var saved = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (saved === "dark" || (saved === null && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();

      // Register service worker for offline support
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js');
        });
      }
    </script>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100 antialiased pb-24">
    <% if notice.present? %>
      <div class="mx-auto max-w-2xl px-5 pt-4">
        <div class="rounded-lg bg-gray-900 text-white text-sm px-4 py-2.5 dark:bg-white dark:text-gray-900">
          <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto max-w-2xl px-5 pt-4">
        <div class="rounded-lg bg-rose-600 text-white text-sm px-4 py-2.5">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <header class="sticky top-0 z-40 bg-white/80 dark:bg-gray-950/80 backdrop-blur border-b border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-2xl px-5 h-16 flex items-center justify-between">
        <span class="text-[15px] font-semibold tracking-tight">Finanzas</span>

        <button
          type="button"
          data-controller="theme"
          data-action="click->theme#toggle"
          aria-label="Cambiar tema"
          class="-mr-2 rounded-full p-2 text-gray-400 hover:text-gray-900 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-800 transition-colors"
        >
          <span class="hidden dark:block"><%= icon(:sun) %></span>
          <span class="block dark:hidden"><%= icon(:moon) %></span>
        </button>
      </div>
    </header>

    <main class="mx-auto max-w-2xl px-5 py-8">
      <%= yield %>
    </main>

    <% if user_signed_in? %>
      <nav class="fixed bottom-0 left-0 right-0 border-t border-gray-100 dark:border-gray-900 bg-white/90 dark:bg-gray-950/90 backdrop-blur">
        <div class="mx-auto max-w-2xl px-2 flex justify-around items-stretch h-16">
          <% nav_items = [
               [root_path, :home, "Inicio", request.path == "/"],
               [transactions_path, :swap, "Gastos", request.path.start_with?("/transactions")],
               [invoices_path, :document, "Facturas", request.path.start_with?("/invoices")],
               [clients_path, :users, "Clientes", request.path.start_with?("/clients")]
             ] %>
          <% nav_items.each do |path, ico, label, active| %>
            <%= link_to path, class: "flex flex-col items-center justify-center gap-1 flex-1 text-[11px] font-medium transition-colors #{active ? 'text-gray-900 dark:text-white' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300'}" do %>
              <%= icon(ico, class: "h-[22px] w-[22px]") %>
              <span><%= label %></span>
            <% end %>
          <% end %>

          <button
            data-controller="menu"
            data-action="click->menu#toggle"
            class="flex flex-col items-center justify-center gap-1 flex-1 text-[11px] font-medium text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
          >
            <%= icon(:menu, class: "h-[22px] w-[22px]") %>
            <span>Más</span>
          </button>
        </div>
      </nav>
    <% end %>

    <% if user_signed_in? %>
      <div id="menu" class="hidden fixed bottom-[76px] right-4 z-50 w-52 rounded-xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xl shadow-gray-900/5 overflow-hidden">
        <%= link_to weekly_budget_path, class: "flex items-center gap-3 px-4 py-3 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" do %>
          <%= icon(:wallet, class: "h-[18px] w-[18px] text-gray-400") %> Presupuesto
        <% end %>
        <%= link_to subscriptions_path, class: "flex items-center gap-3 px-4 py-3 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" do %>
          <%= icon(:repeat, class: "h-[18px] w-[18px] text-gray-400") %> Suscripciones
        <% end %>
        <%= link_to edit_user_registration_path, class: "flex items-center gap-3 px-4 py-3 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors border-t border-gray-100 dark:border-gray-800" do %>
          <%= icon(:users, class: "h-[18px] w-[18px] text-gray-400") %> Mi cuenta
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete, class: "flex w-full items-center gap-3 px-4 py-3 text-sm text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors border-t border-gray-100 dark:border-gray-800" do %>
          <%= icon(:swap, class: "h-[18px] w-[18px]") %> Cerrar sesión
        <% end %>
      </div>
    <% end %>
  </body>
</html>
