<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold tracking-tight">Clientes</h1>
    <%= link_to new_client_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-gray-900 text-white text-sm font-medium px-3.5 py-2 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors" do %>
      <%= icon(:plus, class: "h-4 w-4") %> Nuevo
    <% end %>
  </div>

  <% if @clients.any? %>
    <div class="space-y-3">
      <% @clients.each do |client| %>
        <%= link_to client_path(client), class: "block rounded-xl border border-gray-100 dark:border-gray-800 p-4 hover:border-gray-200 dark:hover:border-gray-700 transition-colors" do %>
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-sm font-semibold text-gray-500 dark:text-gray-400">
              <%= client.name.first.upcase %>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium truncate"><%= client.name %></p>
              <p class="text-xs text-gray-400 truncate"><%= client.email %></p>
            </div>
            <div class="text-right">
              <p class="text-sm font-semibold tabular-nums">$<%= number_with_precision(client.total_invoiced, precision: 2) %></p>
              <p class="text-xs text-gray-400">facturado</p>
            </div>
          </div>

          <% if client.total_pending.positive? %>
            <div class="mt-3 flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
              $<%= number_with_precision(client.total_pending, precision: 2) %> pendiente de cobro
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-200 dark:border-gray-800 py-12 text-center">
      <p class="text-sm text-gray-400">No hay clientes todavía</p>
      <%= link_to "Agregar el primero", new_client_path, class: "mt-2 inline-block text-sm font-medium text-gray-900 dark:text-white hover:underline" %>
    </div>
  <% end %>
</div>
