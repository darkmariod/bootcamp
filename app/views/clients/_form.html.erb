<%
  field = "w-full px-3 py-2.5 border border-gray-200 dark:border-gray-800 rounded-lg bg-white dark:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 dark:focus:ring-white transition-shadow"
  label = "block text-sm font-medium mb-1.5"
%>
<%= form_with model: client, local: true do |f| %>
  <% if client.errors.any? %>
    <div class="mb-4 rounded-lg bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-sm px-4 py-3">
      <%= client.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :name, "Nombre", class: label %>
      <%= f.text_field :name, class: field, placeholder: "Nombre del cliente" %>
    </div>
    <div>
      <%= f.label :email, "Email", class: label %>
      <%= f.email_field :email, class: field, placeholder: "cliente@email.com" %>
    </div>
    <div>
      <%= f.label :phone, "Teléfono", class: label %>
      <%= f.text_field :phone, class: field, placeholder: "Opcional" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit submit_label, class: "flex-1 rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors cursor-pointer" %>
      <%= link_to "Cancelar", clients_path, class: "flex-1 rounded-lg border border-gray-200 dark:border-gray-800 text-sm py-2.5 text-center hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" %>
    </div>
  </div>
<% end %>
