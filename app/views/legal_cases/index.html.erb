<% content_for :title, "Casos — LawyerEC" %>

<%= page_header "Casos", "Expedientes del consorcio" do %>
  <%= link_to "Nuevo caso", new_legal_case_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <div class="p-4 border-b border-stone-100">
    <%= form_with url: legal_cases_path, method: :get, class: "flex flex-wrap gap-2" do |form| %>
      <%= form.text_field :q, value: params[:q], placeholder: "Buscar por título, número de proceso o cliente...",
            class: "flex-1 min-w-48 rounded-lg border border-stone-300 px-3 py-2 text-sm focus:outline-brass-400" %>
      <%= form.select :case_type,
            options_for_select(LegalCase::CASE_TYPE_LABELS.map { |k, v| [ v, k ] }, params[:case_type]),
            { include_blank: "Todas las materias" },
            class: "rounded-lg border border-stone-300 px-3 py-2 text-sm" %>
      <%= form.select :status,
            options_for_select(LegalCase::STATUS_LABELS.map { |k, v| [ v, k ] }, params[:status]),
            { include_blank: "Todos los estados" },
            class: "rounded-lg border border-stone-300 px-3 py-2 text-sm" %>
      <%= form.submit "Filtrar", class: "btn btn-ghost" %>
    <% end %>
  </div>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-stone-500 border-b border-stone-100">
        <th class="px-5 py-3">Caso</th>
        <th class="px-5 py-3">Cliente</th>
        <th class="px-5 py-3">Materia</th>
        <th class="px-5 py-3">Estado</th>
        <th class="px-5 py-3">Abogado</th>
        <th class="px-5 py-3">Actualizado</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% @legal_cases.each do |legal_case| %>
        <tr class="hover:bg-stone-50">
          <td class="px-5 py-3">
            <%= link_to legal_case.title, legal_case_path(legal_case), class: "font-medium text-ink-900 hover:underline" %>
            <% if legal_case.case_number.present? %>
              <p class="text-xs text-stone-400"><%= legal_case.case_number %></p>
            <% end %>
          </td>
          <td class="px-5 py-3 text-stone-600"><%= legal_case.client.name %></td>
          <td class="px-5 py-3"><%= case_type_badge(legal_case) %></td>
          <td class="px-5 py-3"><%= status_badge(legal_case) %></td>
          <td class="px-5 py-3 text-stone-600"><%= legal_case.user&.display_name %></td>
          <td class="px-5 py-3 text-stone-500 text-xs"><%= l legal_case.updated_at, format: :short %></td>
        </tr>
      <% end %>
      <% if @legal_cases.empty? %>
        <tr><td colspan="6" class="px-5 py-10 text-center text-stone-400">No se encontraron casos.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
